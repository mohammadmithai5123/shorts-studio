# ---- AI for ranking the moments (local mode) --------------------------------------------------------
# Easiest: leave this file alone, run `python app.py` and use Settings (the key is saved here for you).
LLM_PROVIDER=gemini            # gemini (free key: https://aistudio.google.com/apikey) or openai
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=auto              # auto = best available Flash model, falls back by itself when one is busy
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ---- Videos that need a login (age-restricted, members-only, "confirm you're not a bot") ------------
# Use the sign-in of a browser you are logged in to YouTube with: chrome, edge, firefox, brave...
YTDLP_COOKIES_BROWSER=
# ...or a cookies.txt exported from your browser (use this when reading the browser directly does not work)
YTDLP_COOKIES_FILE=
# Only if your network needs a proxy to reach YouTube, e.g. http://user:pass@host:8080 (saved write-only in Settings)
YTDLP_PROXY=

# ---- Upload to YouTube (easiest: python app.py -> Settings -> YouTube; README has the one-time Google setup) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private        # private (check in YouTube Studio first), unlisted or public
YOUTUBE_CATEGORY=22            # 22 People & Blogs, 20 Gaming, 24 Entertainment, 23 Comedy ...
YOUTUBE_DAILY_UPLOADS=10       # your own cap per day (Pacific time); extra clips wait for the next day
YOUTUBE_AUTO_RESUME=1          # waiting uploads continue by themselves while the app is open
YOUTUBE_NOTIFY_SUBSCRIBERS=0

# ---- Optional ----------------------------------------------------------------------------------------
LOCAL_OUTPUT_DIR=output
LLM_CACHE=1                    # 0 = never re-use saved AI answers
LOCAL_CAPTION_FONT=            # font family for captions (default: Arial; Nirmala UI for Devanagari)
# Only for videos that have no captions (needs: pip install -r requirements-whisper.txt)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_ENCODER=auto             # auto (graphics chip when it works) or cpu
LOCAL_FACECAM_BG=white         # behind a green-screen streamer on top: white green black blue purple pink
LOCAL_DELETE_UPLOADED=1        # 1 = delete a clip from this computer once it is on YouTube
LOCAL_CACHE_DAYS=3             # saved captions / AI answers older than this are removed by themselves
# LOCAL_MEME_DIR=              # your meme clips (default: "Memes Assets" and "memes" next to app.py)
LOCAL_CAPTION_SCRIPT=roman     # subtitles in Roman letters (Hinglish / Roman Urdu), or original (Hindi / Urdu script)
LOCAL_WHISPER_BEAM_SIZE=5      # 1 = a bit faster, can change the transcript
LOCAL_WHISPER_THREADS=0        # 0 = default (4); keep at or below your physical cores

# SHORTS_STUDIO_PORT=8765       # the web page's port
# LOCAL_WHISPER_VAD_FILTER=false       # skip silence before speech recognition
# LOCAL_WHISPER_VAD_PARAMETERS=        # JSON for that filter
# ---- API mode (python main.py --mode api) -----------------------------------------------------------
MUAPI_API_KEY=your_muapi_key_here
# MUAPI_BASE_URL=https://api.muapi.ai/api/v1
# MUAPI_POLL_INTERVAL=5
# MUAPI_POLL_TIMEOUT=600
